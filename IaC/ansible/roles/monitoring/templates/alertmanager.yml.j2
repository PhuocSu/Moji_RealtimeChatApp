global:
  resolve_timeout: 5m
  slack_api_url: "{{ vault_slack_webhook_url }}"   # taken from vault

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s        # wait 30s to group alerts before sending
  group_interval: 5m     # resend after 5 minutes if alerts persist
  repeat_interval: 12h   # remind again after 12h if not resolved
  receiver: 'slack'

  # Route by severity
  routes:
    - match:
        severity: critical
      receiver: 'slack-critical'
      repeat_interval: 1h   # critical alerts repeat every 1h

receivers:
  # Normal alerts
  - name: 'slack'
    slack_configs:
      - channel: '#alerts'
        send_resolved: true
        title: '{{ "{{" }} template "slack.title" . {{ "}}" }}'
        text: '{{ "{{" }} template "slack.text" . {{ "}}" }}'
        color: '{{ "{{" }} if eq .Status "firing" {{ "}}" }}danger{{ "{{" }} else {{ "}}" }}good{{ "{{" }} end {{ "}}" }}'

  # Critical alerts — separate channel
  - name: 'slack-critical'
    slack_configs:
      - channel: '#alerts-critical'
        send_resolved: true
        title: '🚨 CRITICAL: {{ "{{" }} .GroupLabels.alertname {{ "}}" }}'
        text: '{{ "{{" }} range .Alerts {{ "}}" }}{{ "{{" }} .Annotations.description {{ "}}" }}{{ "{{" }} end {{ "}}" }}'
        color: 'danger'

templates:
  - '/etc/alertmanager/templates/*.tmpl'

inhibit_rules:
  # If a critical alert exists, suppress warnings of the same alertname
  - source_match:
      severity: critical
    target_match:
      severity: warning
    equal: ['alertname']
